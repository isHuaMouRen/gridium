{
	"schemaVersion": 1,
	"id": "gridium",
	"version": "${version}",
	"name": "Gridium",
	"description": "A lightweight UI layout framework for Fabric mods that arranges and renders Minecraft UI elements without manual screen-coordinate calculations.",
	"authors": [
		"HuaMouRen"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/gridium",
		"sources": "https://github.com/isHuaMouRen/gridium",
		"issues": "https://github.com/isHuaMouRen/gridium/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/gridium/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.hua.gridium.Gridium"
		],
		"modmenu": [
			"me.hua.gridium.integration.modmenu.ModMenuIntegration"
		]
	},
	"mixins": [
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": ">=21.0.0"
	}
}